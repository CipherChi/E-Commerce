# Local development and tenant tests use separate databases on the same infra PostgreSQL server (localhost:5432).
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_manager?schema=public"
TENANT_TEST_DATABASE_URL="postgresql://user:password@localhost:5432/hotel_manager_test?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
REDIS_URL=
# false disables proxy trust; use a trusted hop count such as 1 (boolean true is unsupported).
TRUST_PROXY=false
