generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum PropertyType {
  HOTEL
  SHORTLET
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum BookingSource {
  WALK_IN
  PHONE
  AGENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  refreshTokenHash String?
  tokenVersion     Int              @default(0)
  name             String
  role             Role             @default(STAFF)
  propertyId       String?
  property         Property?        @relation("UserProperty", fields: [propertyId], references: [id])
  ownedProperties  Property[]       @relation("PropertyOwner")
  payments         Payment[]        @relation("RecordedBy")
  memberships      BusinessMember[]
  createdAt        DateTime         @default(now())
}

model Business {
  id         String           @id @default(cuid())
  name       String
  phone      String?
  address    String?
  logo       String?
  createdAt  DateTime         @default(now())
  members    BusinessMember[]
  properties Property[]
  rooms      Room[]
  customers  Customer[]
  bookings   Booking[]
  payments   Payment[]
  invoices   Invoice[]
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       String   @default("OWNER")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, createdAt])
}

model Property {
  id         String       @id @default(cuid())
  businessId String
  ownerId    String
  name       String
  address    String
  type       PropertyType @default(HOTEL)
  owner      User         @relation("PropertyOwner", fields: [ownerId], references: [id])
  business   Business     @relation(fields: [businessId], references: [id])
  users      User[]       @relation("UserProperty")
  rooms      Room[]
  createdAt  DateTime     @default(now())

  @@unique([id, businessId])
}

model Room {
  id         String     @id @default(cuid())
  businessId String
  propertyId String
  label      String
  type       String
  capacity   Int
  basePrice  Decimal    @db.Decimal(12, 2)
  status     RoomStatus @default(AVAILABLE)
  property   Property   @relation(fields: [propertyId, businessId], references: [id, businessId])
  business   Business   @relation(fields: [businessId], references: [id])
  bookings   Booking[]

  @@unique([propertyId, label])
  @@unique([id, businessId])
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  idType     String?
  idNumber   String?
  notes      String?
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  business   Business  @relation(fields: [businessId], references: [id])

  @@unique([id, businessId])
}

model Booking {
  id          String        @id @default(cuid())
  businessId  String
  roomId      String
  customerId  String
  checkIn     DateTime
  checkOut    DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @db.Decimal(12, 2)
  source      BookingSource @default(WALK_IN)
  room        Room          @relation(fields: [roomId, businessId], references: [id, businessId])
  customer    Customer      @relation(fields: [customerId, businessId], references: [id, businessId])
  business    Business      @relation(fields: [businessId], references: [id])
  payments    Payment[]
  invoice     Invoice?
  createdAt   DateTime      @default(now())

  @@unique([id, businessId])
  @@index([roomId, checkIn, checkOut])
}

model Payment {
  id           String        @id @default(cuid())
  businessId   String
  bookingId    String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String
  booking      Booking       @relation(fields: [bookingId, businessId], references: [id, businessId])
  recordedBy   User          @relation("RecordedBy", fields: [recordedById], references: [id])
  business     Business      @relation(fields: [businessId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  bookingId     String        @unique
  invoiceNumber String        @unique
  items         Json
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId, businessId], references: [id, businessId])
  business      Business      @relation(fields: [businessId], references: [id])

  @@unique([bookingId, businessId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())
}
