generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum PropertyType {
  HOTEL
  SHORTLET
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum BookingSource {
  WALK_IN
  PHONE
  AGENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  refreshTokenHash String?
  name             String
  role             Role       @default(STAFF)
  propertyId       String?
  property         Property?  @relation("UserProperty", fields: [propertyId], references: [id])
  ownedProperties  Property[] @relation("PropertyOwner")
  payments         Payment[]  @relation("RecordedBy")
  createdAt        DateTime   @default(now())
}

model Property {
  id        String       @id @default(cuid())
  ownerId   String
  name      String
  address   String
  type      PropertyType @default(HOTEL)
  owner     User         @relation("PropertyOwner", fields: [ownerId], references: [id])
  users     User[]       @relation("UserProperty")
  rooms     Room[]
  createdAt DateTime     @default(now())
}

model Room {
  id         String     @id @default(cuid())
  propertyId String
  label      String
  type       String
  capacity   Int
  basePrice  Decimal    @db.Decimal(12, 2)
  status     RoomStatus @default(AVAILABLE)
  property   Property   @relation(fields: [propertyId], references: [id])
  bookings   Booking[]

  @@unique([propertyId, label])
}

model Guest {
  id        String    @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  idType    String?
  idNumber  String?
  notes     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id          String        @id @default(cuid())
  roomId      String
  guestId     String
  checkIn     DateTime
  checkOut    DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @db.Decimal(12, 2)
  source      BookingSource @default(WALK_IN)
  room        Room          @relation(fields: [roomId], references: [id])
  guest       Guest         @relation(fields: [guestId], references: [id])
  payments    Payment[]
  invoice     Invoice?
  createdAt   DateTime      @default(now())

  @@index([roomId, checkIn, checkOut])
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String
  booking      Booking       @relation(fields: [bookingId], references: [id])
  recordedBy   User          @relation("RecordedBy", fields: [recordedById], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  invoiceNumber String        @unique
  items         Json
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())
}
