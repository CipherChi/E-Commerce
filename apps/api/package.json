{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.config.json --runInBand",
    "test:e2e:auth": "jest --config ./test/jest-e2e.config.json --runInBand --runTestsByPath ./test/auth.e2e-spec.ts",
    "test:e2e:tenant": "jest --config ./test/jest-e2e.config.json --runInBand --runTestsByPath ./test/tenant-isolation.e2e-spec.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@hotel/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "^0.20.2",
    "redis": "4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "3.24.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "^6.1.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
