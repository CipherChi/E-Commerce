{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "start:dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.config.json --runInBand",
    "test:e2e:auth": "jest --config ./test/jest-e2e.config.json --runInBand --runTestsByPath ./test/auth.e2e-spec.ts",
    "test:e2e:tenant": "jest --config ./test/jest-e2e.config.json --runInBand --runTestsByPath ./test/tenant-isolation.e2e-spec.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@hotel/shared-types": "workspace:*",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "express": "4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "^0.20.2",
    "redis": "4.7.0",
    "validator": "13.15.35",
    "zod": "3.24.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "6.0.2",
    "@types/validator": "13.15.10",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "jest": "29.7.0",
    "prisma": "^6.1.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
